# Copie este arquivo para ".env" e preencha com as credenciais reais.
# NUNCA preencha valores reais aqui neste arquivo (.env.example é versionado no git).

# --- Ileva API ---
# Gerado seguindo docs/api-ileva/COMO_GERAR_CHAVE_API.md
ILEVA_API_BASE_URL=https://api.ileva.com.br
ILEVA_APP_KEY=
ILEVA_API_USERNAME=
ILEVA_API_PASSWORD=

# --- Omie API ---
# App de teste: Omie > Meus Aplicativos > "Novo teste grátis" (válido por 7 dias)
OMIE_API_BASE_URL=https://app.omie.com.br/api/v1
OMIE_APP_KEY=
OMIE_APP_SECRET=

# --- Supabase (preencher quando o projeto for criado) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
